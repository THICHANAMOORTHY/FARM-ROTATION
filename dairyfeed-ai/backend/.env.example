# DairyFeed AI backend — copy to backend/.env and fill in.

# Supabase: Project Settings -> API. Leave both EMPTY to run without a database
# (data is kept in memory and lost on restart) — fine for a demo.
# Example: SUPABASE_URL=https://abcdefgh.supabase.co
SUPABASE_URL=
# Use the service_role key (the backend bypasses RLS). Never put this key in the frontend or firmware.
SUPABASE_SERVICE_KEY=

# Shared secret every ESP32 sends in the X-Device-Key header. Must match secrets.h on the devices.
# "demo-key" is for local demos only: generate a real one before using real devices.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
DEVICE_API_KEY=demo-key

# Token for the expert labelling page on the dashboard.
ADMIN_TOKEN=admin-demo

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Folder with trained models. Leave empty to use dairyfeed-ai/ml/models.
ML_MODELS_DIR=
