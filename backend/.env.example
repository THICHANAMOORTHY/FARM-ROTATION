# ============================================================
# UZHAVU KAAPPAAN (CropSmart P025) — Environment Configuration
# Copy this file to backend/.env and fill in the values you have.
# Every key is optional — the app degrades gracefully without any
# of them (in-memory data, rule-based chatbot, keyword-only B2B
# matching). See README.md "Environment Variables" for details.
# ============================================================

PORT=3000

# ── Supabase (optional — falls back to in-memory data if unset) ──
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-secret-key

# ── Google Gemini AI (optional — powers the Kisan chatbot's AI
#    replies and the B2B AI Matchmaker's free-text parsing/reasoning;
#    both fall back to rule-based logic if this is unset) ──
GEMINI_API_KEY=your_gemini_api_key

# ── Auth — JWT signing secrets (required for account creation) ──
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, the server generates an ephemeral secret at boot,
# which means all sessions are invalidated on every restart.
JWT_ACCESS_SECRET=replace_with_a_long_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── ESP32 Live Soil Sensor (optional — required only to accept
#    readings from a real/simulated ESP32 device) ──
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Must match the DEVICE_KEY flashed into esp32/soil_sensor_client.ino
# and the value backend/scripts/simulate_esp32.js reads to pose as one.
ESP32_DEVICE_KEY=replace_with_a_random_hex_string
